project_id = "my-gcp-project"

# Free-tier regions only: us-west1 | us-central1 | us-east1
region = "us-central1"
zone   = "us-central1-a"

ssh_user = "misho"

# owner/repo permitted to impersonate the deployer service account.
github_repository = "ipetkovic/misho"

# Inert while OS Login is enabled (the default). Kept as a break-glass key.
ssh_public_key_path = "~/.ssh/id_ed25519.pub"

# Leave empty. SSH arrives through the IAP tunnel, which is allow-listed
# separately, so port 22 stays closed to the internet. Populate this only to
# break the glass (IAP or OS Login misconfigured), and empty it again after.
ssh_source_ranges = []
