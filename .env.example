# Copy to .env for local runs. The VM's .env is rendered by
# .github/workflows/deploy.yml from GitHub Actions secrets -- never copied
# from here.

# TEST or PROD. Anything else is a hard startup failure, deliberately: a
# silent fallback used to mean a typo ran TEST settings against the live site.
# Local runs want TEST, which sets dummy_reservation=True so that nothing is
# actually booked on sportbooking.info.
MISHO_ENVIRONMENT=TEST

# Use a SECOND bot from BotFather here, not the production one. Telegram
# delivers each update exactly once per token, so a local instance sharing the
# production token silently steals real users' messages.
TELEGRAM_BOT_TOKEN=

OPENAI_API_KEY=

# Telegram username without the leading @. Allow-listed on startup and
# permitted to run /invite.
MISHO_ADMIN_TELEGRAM_USERNAME=
